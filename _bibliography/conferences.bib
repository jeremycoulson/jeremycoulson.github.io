}

@inproceedings{huangDataEnabledPredictiveControl2019,
  title = {Data-{{Enabled Predictive Control}} for {{Grid-Connected Power Converters}}},
  booktitle = {2019 {{IEEE}} 58th {{Conference}} on {{Decision}} and {{Control}} ({{CDC}})},
  author = {Huang, Linbin and Coulson, Jeremy and Lygeros, John and Dörfler, Florian},
  date = {2019-12},
  pages = {8130--8135},
  issn = {2576-2370},
  doi = {10.1109/CDC40024.2019.9029522},
  url = {https://ieeexplore.ieee.org/document/9029522/},
  urldate = {2026-03-28},
  abstract = {We apply a novel data-enabled predictive control (DeePC) algorithm in grid-connected power converters to perform safe and optimal control. Rather than a model, the DeePC algorithm solely needs input/output data measured from the unknown system to predict future trajectories. We show that the DeePC can eliminate undesired oscillations in a grid-connected power converter and stabilize an unstable system. However, the DeePC algorithm may suffer from poor scalability when applied in high-order systems. To this end, we present a finite-horizon output-based model predictive control (MPC) for grid-connected power converters, which uses an N-step auto-regressive-moving-average (ARMA) model for system representation. The ARMA model is identified via an N-step prediction error method (PEM) in a recursive way. We investigate the connection between the DeePC and the concatenated PEM-MPC method, and then analytically and numerically compare their closed-loop performance. Moreover, the PEM-MPC is applied in a voltage source converter based HVDC station which is connected to a two-area power system so as to eliminate low-frequency oscillations. All of our results are illustrated with high-fidelity, nonlinear, and noisy simulations.},
  eventtitle = {2019 {{IEEE}} 58th {{Conference}} on {{Decision}} and {{Control}} ({{CDC}})},
  keywords = {Noise measurement,Optimization,Prediction algorithms,Predictive control,Predictive models,Scalability,Trajectory},
  file = {/Users/jeremycoulson/Zotero/storage/K49V62NW/Huang et al. - 2019 - Data-Enabled Predictive Control for Grid-Connected Power Converters.pdf;/Users/jeremycoulson/Zotero/storage/RG74ADEA/1903.07339v1.pdf}
}

@inproceedings{padoanBehavioralUncertaintyQuantification2022,
  title = {Behavioral Uncertainty Quantification for Data-Driven Control},
  booktitle = {2022 {{IEEE}} 61st {{Conference}} on {{Decision}} and {{Control}} ({{CDC}})},
  author = {Padoan, Alberto and Coulson, Jeremy and family=Waarde, given=Henk J., prefix=van, useprefix=true and Lygeros, John and Dörfler, Florian},
  date = {2022-12},
  eprint = {2204.02671},
  eprinttype = {arXiv},
  pages = {4726--4731},
  issn = {2576-2370},
  doi = {10.1109/CDC51059.2022.9993002},
  url = {https://ieeexplore.ieee.org/document/9993002/},
  urldate = {2026-03-28},
  abstract = {This paper explores the problem of uncertainty quantification in the behavioral setting for data-driven control. Building on classical ideas from robust control, the problem is regarded as that of selecting a metric which is best suited to a data-based description of uncertainties. Leveraging on Willems’ fundamental lemma, restricted behaviors are viewed as subspaces of fixed dimension, which may be represented by data matrices. Consequently, metrics between restricted behaviors are defined as distances between points on the Grassmannian, i.e., the set of all subspaces of equal dimension in a given vector space. A new metric is defined on the set of restricted behaviors as a direct finite-time counterpart of the classical gap metric. The metric is shown to capture parametric uncertainty for the class of autoregressive (AR) models. Numerical simulations illustrate the value of the new metric with a data-driven mode recognition and control case study.},
  eventtitle = {2022 {{IEEE}} 61st {{Conference}} on {{Decision}} and {{Control}} ({{CDC}})},
  keywords = {Geometry,Manifolds,Measurement,Numerical simulation,Real-time systems,Robust control,Uncertainty},
  file = {/Users/jeremycoulson/Zotero/storage/L57Z4MLM/Padoan et al. - 2022 - Behavioral uncertainty quantification for data-driven control.pdf;/Users/jeremycoulson/Zotero/storage/URM8ECM2/2204.02671v1.pdf}
}

