  title = {A Quantitative and Constructive Proof of {{Willems}}’ {{Fundamental Lemma}} and Its Implications},
  booktitle = {2023 {{American Control Conference}} ({{ACC}})},
  author = {Berberich, Julian and Iannelli, Andrea and Padoan, Alberto and Coulson, Jeremy and Dörfler, Florian and Allgöwer, Frank},
