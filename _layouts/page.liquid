---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% if page.banner_image %}
  <img src="{{ page.banner_image | prepend: '/assets/img/' | relative_url }}" alt="{{ page.title }} banner" class="page-banner" style="object-position: {{ page.banner_position | default: 'center top' }}; height: {{ page.banner_height | default: '280px' }}">
{% endif %}
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
