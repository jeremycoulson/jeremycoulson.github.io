---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {% if page.banner_image %}
    <div style="
      background-image: url('{{ '/assets/img/' | append: page.banner_image | relative_url }}');
      background-position: {{ page.banner_position | default: 'center center' }};
      background-size: cover;
      height: {{ page.banner_height | default: '250px' }};
      border-radius: 6px;
      margin-bottom: 1.5rem;
    "></div>
  {% endif %}
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
